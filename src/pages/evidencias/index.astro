---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';

const evidencias = (await getCollection('evidencias')).sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER),
);

// Cada categoría lista sus evidencias; `extra` enlaza trabajo que vive en Proyectos.
const categorias = [
  {
    nombre: 'SQL',
    extra: {
      texto: 'Esquema, datos semilla y consultas del proyecto del gimnasio',
      href: '/works/gimnasio-bd2/#modelo-relacional-sql',
    },
  },
  { nombre: 'PL/SQL', extra: undefined },
  { nombre: 'NoSQL', extra: undefined },
  {
    nombre: 'Proyecto',
    extra: {
      texto: 'Sistema de Gestión de Gimnasio, el proyecto final del curso',
      href: '/works/gimnasio-bd2/',
    },
  },
] as const;
---

<BaseLayout
  title="Evidencias"
  description="Evidencias del curso Bases de Datos 2: SQL, PL/SQL, NoSQL y Proyecto."
>
  <section class="page-head section">
    <p class="eyebrow">Evidencias</p>
    <h1>Evidencias del curso</h1>
    <p class="lead">Aquí iré publicando el trabajo del semestre, organizado por categoría.</p>
  </section>

  <section class="section">
    <div class="work-list">
      {
        categorias.map(({ nombre, extra }) => {
          const items = evidencias.filter((e) => e.data.categoria === nombre);
          return (
            <article class="work-card">
              <h2>{nombre}</h2>
              {items.length === 0 && !extra && <p>Próximamente.</p>}
              {items.length > 0 && (
                <ul>
                  {items.map((e) => (
                    <li>
                      <a class="text-link" href={withBase(`/evidencias/${e.id}/`)}>
                        {e.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {extra && (
                <p>
                  <a class="text-link" href={withBase(extra.href)}>
                    {extra.texto}
                  </a>
                </p>
              )}
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
